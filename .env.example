NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chỉ dùng ở server, KHÔNG đặt tiền tố NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
# Chỉ cho Supabase CLI
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Chỉ môi trường LOCAL: hiện 3 tài khoản thử trên trang đăng nhập (cần chạy scripts/seed-test.mjs).
# Dev server tự bật; với `next start` cục bộ thì đặt SHOW_TEST_LOGINS=1. Không đặt các biến này khi triển khai.
TEST_PASSWORD=
SHOW_TEST_LOGINS=

# Email hệ thống (đăng ký, quên mật khẩu) qua Gmail SMTP: dùng một tài khoản Gmail riêng + Mật khẩu ứng dụng
# (https://myaccount.google.com/apppasswords, cần bật xác minh 2 bước). Đặt mật khẩu trong dấu ngoặc kép.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=""
